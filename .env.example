# Copia este archivo a .env. No reemplaces las contraseñas de una base existente.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://10.60.11.76:5173,http://100.74.209.47:5173
LOCAL_AUTH_ENABLED=true
PORT=3001
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=espacio_to
DB_USER=espacio_to
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Vacío permite registrarse; una lista limita Google y las cuentas locales.
ALLOWED_EMAILS=
# Solo para el servidor; nunca usar un nombre VITE_ para la clave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Docker: cambia la IP si quieres publicar la web en la red local.
WEB_BIND_ADDRESS=127.0.0.1
